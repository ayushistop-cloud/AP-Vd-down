# ── 3AP Video Downloader — Environment Configuration Reference ──────────────
# Copy this file to .env or .env.local for development.
# NEVER commit real production secrets to version control.

# Runtime Environment: local | staging | production
NODE_ENV=local

# ── API Service ───────────────────────────────────────────────────────────────
API_PORT=8787
API_HOST=127.0.0.1
# Comma-separated allowed CORS web origins
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Canonical public application URL for SEO, OG images, and links
PUBLIC_APP_URL=http://localhost:5173
# Set to true when running behind a trusted reverse proxy (nginx, load balancer)
TRUST_PROXY=false

# Secrets (Required in staging & production)
DOWNLOAD_TOKEN_SECRET=dev-only-secret-change-me
IP_HASH_PEPPER=dev-only-pepper-change-me

# ── Database (Required in production) ──────────────────────────────────────────
# PostgreSQL connection string
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/threap

# ── Queue / Redis (Required in production) ─────────────────────────────────────
# Redis connection string for multi-process distributed queue
# REDIS_URL=redis://localhost:6379

# ── Artifact Storage ──────────────────────────────────────────────────────────
# Storage mode: local | s3
ARTIFACT_STORAGE=local
ARTIFACT_ROOT=./data/artifacts
ARTIFACT_TTL_MINUTES=30
RESOLVE_TTL_MINUTES=15

# S3 Configuration (Required if ARTIFACT_STORAGE=s3)
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=my-3ap-artifacts
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# ── Limits & Quotas ───────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=500
MAX_PLAYLIST_ITEMS=50
JOB_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS_PER_IP=3

# Rate Limits (per IP sliding window)
RATE_RESOLVE_PER_MINUTE=20
RATE_JOB_CREATE_PER_MINUTE=10
RATE_DOWNLOAD_PER_MINUTE=60

# Per-platform Worker Concurrency
WORKER_CONCURRENCY_GLOBAL=4
WORKER_CONCURRENCY_YOUTUBE=2
WORKER_CONCURRENCY_TIKTOK=2
WORKER_CONCURRENCY_INSTAGRAM=2
WORKER_CONCURRENCY_FACEBOOK=2
WORKER_CONCURRENCY_TERABOX=1

# ── Media Engine ──────────────────────────────────────────────────────────────
# Explicit executable path or system command (default searches bin/ then PATH)
YT_DLP_PATH=
FFMPEG_PATH=

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
