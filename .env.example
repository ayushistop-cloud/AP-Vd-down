# ── 3AP Video Downloader — Production Environment Template ──────────────────
# Copy to environment secrets manager or production .env on your host.

NODE_ENV=production

API_PORT=8787
API_HOST=0.0.0.0
# CRITICAL: Must include Vercel frontend origin or CORS will block playback streams
WEB_ORIGINS=https://3ap-video-downloader.vercel.app,https://example.com
PUBLIC_APP_URL=https://3ap-video-downloader.vercel.app
TRUST_PROXY=true

# ── Frontend (Vercel) ─────────────────────────────────────────────────────────
# Set in Vercel dashboard → Settings → Environment Variables (Production + Preview + Development)
# Vercel will bake this at build time — redeploy after changing it.
# Vite requires the VITE_ prefix to expose the variable to the browser bundle.
# Frontend fallback now targets Render even if this is missing, but setting it explicitly is required for correctness.
# VITE_API_BASE_URL=https://threeap-api.onrender.com

# REQUIRED: Generate strong 32+ char random strings
DOWNLOAD_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_SECURE_RANDOM_SECRET_32_CHARS
IP_HASH_PEPPER=CHANGE_ME_TO_A_LONG_SECURE_RANDOM_SALT_16_CHARS

# REQUIRED: Production PostgreSQL Database
DATABASE_URL=postgres://3ap_user:SECURE_DB_PASSWORD@postgres_host:5432/3ap_production

# REQUIRED: Production Redis Cluster / Server
REDIS_URL=redis://:SECURE_REDIS_PASSWORD@redis_host:6379/0

# ARTIFACT STORAGE (local or s3)
# Render filesystem is ephemeral/temporary — local disk is used for temporary
# processing and streaming with automatic TTL cleanup. Zero S3 credentials required.
ARTIFACT_STORAGE=local
ARTIFACT_ROOT=/var/lib/3ap/artifacts
ARTIFACT_TTL_MINUTES=30
RESOLVE_TTL_MINUTES=15

# If ARTIFACT_STORAGE=s3:
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=production-3ap-artifacts
# S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_KEY

# Limits
MAX_FILE_SIZE_MB=500
MAX_PLAYLIST_ITEMS=50
JOB_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS_PER_IP=3

RATE_RESOLVE_PER_MINUTE=30
RATE_JOB_CREATE_PER_MINUTE=15
RATE_DOWNLOAD_PER_MINUTE=90

WORKER_CONCURRENCY_GLOBAL=8
WORKER_CONCURRENCY_YOUTUBE=4
WORKER_CONCURRENCY_TIKTOK=4
WORKER_CONCURRENCY_INSTAGRAM=4
WORKER_CONCURRENCY_FACEBOOK=4
WORKER_CONCURRENCY_TERABOX=2

# Engine Paths (Linux container default)
YT_DLP_PATH=/usr/local/bin/yt-dlp
FFMPEG_PATH=/usr/bin/ffmpeg

LOG_LEVEL=info
